# COA Engine Configuration
# Copy to .env and fill in values. All settings use the COA_ prefix.

# LLM integration (optional — engine works without it using deterministic fallbacks)
# Set COA_LLM_ENABLED=true and point to a llama.cpp OpenAI-compatible server.
COA_LLM_ENABLED=true
COA_LLM_BASE_URL=http://192.168.4.14:8080/v1
COA_LLM_API_KEY=
COA_LLM_MODEL=local
COA_LLM_TIMEOUT_SECONDS=300
COA_LLM_MAX_TOKENS=2048

# API server
COA_RATE_LIMIT_PER_MINUTE=60
COA_RATE_LIMIT_ENABLED=true
COA_CORS_ORIGINS_CSV=*

# Simulation
COA_SIMULATION_RUNS=1000
COA_SIMULATION_SEED=42
