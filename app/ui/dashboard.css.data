.tl-section{margin-bottom:12px}
.tl-section-hdr{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;padding:5px 0 4px;border-bottom:1px solid #334155;margin-bottom:4px;display:flex;align-items:center;gap:6px}
.tl-section-hdr .tl-section-cnt{font-size:9px;padding:1px 6px;border-radius:999px;font-weight:700}
.tl-section-hdr.fired-hdr{color:#6ee7b7}.tl-section-hdr.fired-hdr .tl-section-cnt{background:#052e16;color:#4ade80}
.tl-section-hdr.active-hdr{color:#fbbf24}.tl-section-hdr.active-hdr .tl-section-cnt{background:#3f2f08;color:#facc15}
.tl-section-hdr.upcoming-hdr{color:#64748b}.tl-section-hdr.upcoming-hdr .tl-section-cnt{background:#1e293b;color:#94a3b8}
