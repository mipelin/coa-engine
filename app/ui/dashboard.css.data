.query-sources{margin-top:8px;font-size:10px;color:#94a3b8}
.query-sources b{color:#cbd5e1}
.query-forecast-card{background:#1a1505;border:1px solid #854d0e;border-radius:8px;padding:10px 12px;margin-top:10px}
.query-forecast-hdr{font-size:10px;font-weight:700;color:#fbbf24;text-transform:uppercase;letter-spacing:.5px;margin-bottom:6px;display:flex;align-items:center;gap:6px}
.query-forecast-body{font-size:11px;color:#e2e8f0;line-height:1.5}
