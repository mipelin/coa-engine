.tl-act{padding:2px 8px;border-radius:4px;font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.3px;flex-shrink:0;min-width:80px;text-align:center}
.tl-act.cable_severance{background:#7f1d1d;color:#fca5a5;border:1px solid #991b1b}
.tl-act.jamming{background:#431407;color:#fb923c;border:1px solid #c2410c}
.tl-act.course_change{background:#1e3a5f;color:#60a5fa;border:1px solid #1e3a5f}
.tl-act.hostile_intent{background:#4c1d95;color:#c4b5fd;border:1px solid #6d28d9}
.tl-act.surface{background:#065f46;color:#6ee7b7;border:1px solid #166534}
.tl-act.slow_near_cable{background:#713f12;color:#fde047;border:1px solid #a16207}
.tl-act.reposition{background:#1e3a5f;color:#93c5fd;border:1px solid #1e3a5f}
.tl-act.uav_detection{background:#312e81;color:#a5b4fc;border:1px solid #4338ca}
.tl-act.convoy_sighting{background:#134e4a;color:#5eead4;border:1px solid #0f766e}
.tl-act.unknown{background:#1e293b;color:#94a3b8;border:1px solid #334155}
.tl-desc{color:#cbd5e1;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:10px}
.tl-ent{color:#93c5fd;font-size:9px;flex-shrink:0;max-width:100px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.tl-status{font-size:9px;font-weight:700;text-transform:uppercase;padding:2px 6px;border-radius:3px;flex-shrink:0}
.tl-status.fired{color:#6ee7b7;background:#052e16}
.tl-status.upcoming{color:#94a3b8;background:#1e293b}
.tl-status.active{color:#fbbf24;background:#3f2f08;animation:tl-active-pulse 2s ease-in-out infinite}
@keyframes tl-active-pulse{0%,100%{opacity:1}50%{opacity:.6}}
.tl-env{display:flex;gap:8px;flex-wrap:wrap;padding:4px 8px;background:#0f172a;border:1px solid #1e293b;border-radius:6px;margin-bottom:8px;font-size:10px}
