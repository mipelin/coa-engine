.query-chip:hover{background:#334155;border-color:#60a5fa;color:#bfdbfe}
.query-response-card{background:linear-gradient(180deg,#172033 0%,#111827 100%);border:1px solid #243246;border-radius:10px;padding:12px;margin-bottom:8px}
