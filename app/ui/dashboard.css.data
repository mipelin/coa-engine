.query-disclaimer{background:#1e1b4b;border:1px solid #3730a3;border-radius:8px;padding:8px 12px;margin-bottom:10px;font-size:10px;color:#c7d2fe;display:flex;align-items:flex-start;gap:8px;line-height:1.5}
