.roe-auth-warning{background:linear-gradient(90deg,#431407,#1a1005);border:2px solid #c2410c;border-radius:6px;padding:10px 14px;margin:8px 0;font-size:12px;color:#fed7aa;display:flex;align-items:center;gap:10px;flex-wrap:wrap;animation:roe-pulse 2s ease-in-out infinite}
.roe-auth-icon{font-size:18px}
.roe-auth-badge{background:#c2410c;color:#fff;padding:2px 10px;border-radius:999px;font-size:10px;font-weight:700;text-transform:uppercase;margin-left:4px}
.coa-card.rank1.roe-restricted,.coa-card.rank1.roe-requires_authorization{border-left-color:#f59e0b;background:linear-gradient(90deg,#1a1505,#10261b)}
