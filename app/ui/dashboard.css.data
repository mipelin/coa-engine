.query-bar input{flex:1;background:#0f172a;border:1px solid #334155;color:#e2e8f0;padding:8px 10px;border-radius:6px;font-size:11px;outline:none}
.query-bar input:focus{border-color:#60a5fa;box-shadow:0 0 0 2px #1e3a5f80}
.query-bar input::placeholder{color:#4b5563}
.query-bar button{background:#2563eb;color:#fff;border:none;padding:8px 20px;border-radius:6px;font-size:11px;font-weight:600;cursor:pointer;flex-shrink:0}
.query-bar button:hover{background:#1d4ed8}
