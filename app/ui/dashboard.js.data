        <div class="metric-card"><div class="lbl">Snapshots</div><div class="val">${esc(String(replay.snapshots_count || 0))}</div></div>
        <div class="metric-card"><div class="lbl">First Tick</div><div class="val">${esc(String(replay.first_tick || '--'))}</div></div>
        <div class="metric-card"><div class="lbl">Last Tick</div><div class="val">${esc(String(replay.last_tick || '--'))}</div></div>
        <div class="metric-card"><div class="lbl">Latest Lesson</div><div class="val">${esc(replay.latest_lesson || '—')}</div></div>
      </div>
      <div class="cop-item-sub">Last major change: ${esc(replay.last_major_change || '—')}</div>
