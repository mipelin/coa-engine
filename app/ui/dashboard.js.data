function esc(value) {
  return String(value ?? '').replace(/[&<>"']/g, (m) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
}

function t(key, fallback) {
  return state.uiTranslations[key] || UI_TEXT[key] || fallback || key;
}

function tf(key, fallback, vars = {}) {
  return t(key, fallback).replace(/\{(\w+)\}/g, (_, name) => String(vars[name] ?? ''));
}

function collectSourceUiStrings() {
  if (state.sourceUiStrings) return state.sourceUiStrings;
  const strings = {...UI_TEXT};
  document.querySelectorAll('[data-i18n]').forEach((node) => {
    const key = node.dataset.i18n;
    if (!key || strings[key]) return;
    strings[key] = node.innerHTML.trim();
  });
  document.querySelectorAll('[data-i18n-placeholder]').forEach((node) => {
    const key = node.dataset.i18nPlaceholder;
    if (!key || strings[key]) return;
    strings[key] = (node.getAttribute('placeholder') || '').trim();
  });
  document.querySelectorAll('[data-q-key]').forEach((node) => {
    const key = node.dataset.qKey;
    if (!key || strings[key]) return;
    strings[key] = (node.getAttribute('data-q') || '').trim();
  });
  state.sourceUiStrings = strings;
  return strings;
}

async function getUiTranslations(language) {
  const existing = state.uiTranslationCache[language];
  if (existing && existing.__ready) return existing;
  const translations = existing || {...(STATIC_UI_TRANSLATIONS[language] || {})};
  state.uiTranslationCache[language] = translations;
  if (language === 'en') {
    translations.__ready = true;
    return translations;
  }

  const sourceStrings = collectSourceUiStrings();
  const missing = {};
  Object.entries(sourceStrings).forEach(([key, value]) => {
    if (!translations[key]) missing[key] = value;
  });

  if (Object.keys(missing).length) {
    try {
      const result = await api('/v1/engine/translate-ui', {
        method: 'POST',
        body: JSON.stringify({language, strings: missing}),
      });
      Object.assign(translations, result.translations || {});
    } catch (_error) {
      // Keep static or English fallback text when dynamic translation is unavailable.
    }
  }

  translations.__ready = true;
  return translations;
}

function applyStaticTranslations() {
  document.querySelectorAll('[data-i18n]').forEach((node) => {
    const key = node.dataset.i18n;
    if (!key) return;
    const translated = t(key, node.innerHTML);
    const counter = node.querySelector('.tab-cnt');
    if (counter) {
      const countHtml = counter.outerHTML;
      const label = translated.replace(/<[^>]*>/g, '').trim();
      node.innerHTML = `${esc(label)} ${countHtml}`;
      return;
    }
    node.innerHTML = translated;
  });
  document.querySelectorAll('[data-i18n-placeholder]').forEach((node) => {
    const key = node.dataset.i18nPlaceholder;
    if (!key) return;
    node.setAttribute('placeholder', t(key, node.getAttribute('placeholder') || ''));
  });
}

function renderQueryUi() {
  const input = document.getElementById('query-input');
  const button = document.getElementById('query-ask-btn');
  const disclaimerTitle = document.getElementById('query-disclaimer-title');
  const disclaimerBody = document.getElementById('query-disclaimer-body');

  if (input) input.setAttribute('placeholder', t('query.input_placeholder', 'Ask about the current situation, a COA, or a what-if scenario...'));
  if (button) button.textContent = t('query.ask_btn', 'Ask');
  if (disclaimerTitle) disclaimerTitle.textContent = t('query.disclaimer_title', 'Advisory only.');
  if (disclaimerBody) disclaimerBody.textContent = t('query.disclaimer_body', 'LLM explains; forecasts are simulation-based. Responses do not authorize decisions or actions.');

  document.querySelectorAll('.query-chip').forEach((chip) => {
    const labelKey = chip.dataset.i18n;
    const questionKey = chip.dataset.qKey;
    if (labelKey) chip.textContent = t(labelKey, chip.textContent);
    if (questionKey) chip.setAttribute('data-q', t(questionKey, chip.getAttribute('data-q') || ''));
  });
}

function fmtPct(value) {
  if (value === null || value === undefined || Number.isNaN(Number(value))) return '--';
  return `${Math.round(Number(value) * 100)}%`;
}

function fmtCoord(value) {
  if (value === null || value === undefined || Number.isNaN(Number(value))) return '--';
  return Number(value).toFixed(6);
}

function fmtLatLon(lat, lon) {
  return `${fmtCoord(lat)}, ${fmtCoord(lon)}`;
}

function normalizeUnitClass(contact) {
  const attrs = contact?.attributes || {};
  const domain = String(attrs.domain || '').toLowerCase();
  const subtype = String(attrs.subtype || '').toLowerCase();
  const explicit = attrs.unit_class || contact?.contact_type || 'unknown';
  if (domain === 'air' || subtype === 'commercial_airliner' || subtype === 'military_jet' || subtype === 'helicopter') return 'aircraft';
  if (subtype === 'uav') return 'uav';
  if (domain === 'subsurface' || subtype === 'submarine') return 'submarine';
  if (domain === 'surface' && subtype) return 'vessel';
  return explicit;
}

function normalizedAllegiance(contact) {
  const allegiance = String(contact?.attributes?.allegiance || '').toLowerCase();
  if (allegiance === 'neutral' || allegiance === 'infrastructure') return allegiance;
  if (contact?.is_hostile || allegiance === 'hostile' || allegiance === 'red') return 'hostile';
  return 'friendly';
}

function contactSource(contact) {
  const source = String(contact?.source || contact?.attributes?.source_system || '').toLowerCase();
  if (source === 'combat_system' || contact?.attributes?.combat_contact) return 'combat_system';
  if (source === 'aishub' || source === 'noaa_replay' || source === 'ais') return 'ais';
  if (source === 'simulation' || source === 'dashboard') return 'simulation';
  return source || 'simulation';
}

function contactDomain(contact) {
  const attrDomain = String(contact?.attributes?.domain || '').toLowerCase();
  if (attrDomain === 'air') return 'air';
  if (attrDomain === 'land') return 'land';
  if (attrDomain === 'infra') return 'infra';
  if (attrDomain === 'surface' || attrDomain === 'subsurface') return 'naval';
  const unitClass = normalizeUnitClass(contact);
  if (['aircraft', 'uav', 'isr_asset'].includes(unitClass) || contact.contact_type === 'uav') return 'air';
  if (['ground_unit', 'convoy'].includes(unitClass) || contact.contact_type === 'convoy') return 'land';
  if (['event_marker', 'infrastructure', 'jamming', 'cable_event'].includes(unitClass) || ['infrastructure', 'jamming', 'cable_event'].includes(contact.contact_type)) return 'infra';
  return 'naval';
}

function isEventContact(contact) {
  const unitClass = normalizeUnitClass(contact);
  return ['event_marker', 'jamming', 'cable_event'].includes(unitClass) || ['jamming', 'cable_event'].includes(contact.contact_type);
}

function sourceLabel(contact) {
  const source = contactSource(contact);
  if (source === 'ais') return 'AIS';
  if (source === 'combat_system') return 'Combat System';
  if (source === 'fused') return 'Heuristic Fusion';
  if (source === 'simulation') return 'Simulation';
  return source;
}

function provenanceLabel(source) {
  const labels = state.cop?.provenance_labels || {};
  return labels[String(source || '').toLowerCase()] || sourceLabel({source});
}

function findSelectedFusedTrack() {
  if (!state.selectedEntityId || state.selectedContactSource !== 'fused') return null;
  return (state.fusedTracks || []).find((track) =>
    track.primary_entity_id === state.selectedEntityId ||
    track.track_id === state.selectedEntityId ||
    (track.correlated_entities || []).includes(state.selectedEntityId)
  ) || null;
}

function findSelectedTarget() {
  if (!state.selectedEntityId) return null;
  return (state.targets || []).find((target) => target.entity_id === state.selectedEntityId) ||
    (state.topTargets || []).find((target) => target.entity_id === state.selectedEntityId) ||
    null;
}

function findSelectedContact() {
  if (!state.selectedEntityId) return null;
  const source = state.selectedContactSource || 'simulation';
  if (source === 'fused') {
    const selectedTrack = findSelectedFusedTrack();
    if (selectedTrack) {
      return (state.contacts || []).find((contact) =>
        contact.entity_id === selectedTrack.primary_entity_id ||
        (selectedTrack.correlated_entities || []).includes(contact.entity_id)
      ) || null;
    }
  }
  if (source === 'ais') {
    return (state.aisContacts || []).find((contact) => contact.entity_id === state.selectedEntityId) ||
      (state.contacts || []).find((contact) => contact.entity_id === state.selectedEntityId && contactSource(contact) === 'ais') ||
      null;
  }
  return (state.contacts || []).find((contact) => contact.entity_id === state.selectedEntityId && contactSource(contact) === source) ||
    (state.contacts || []).find((contact) => contact.entity_id === state.selectedEntityId) ||
    null;
}

function fusedTrackToRenderable(track) {
  const primarySource = (track.sources || [])[0] || 'fused';
  const trackType = track.track_type || 'unknown';
  const unitClass = {
    vessel: 'vessel',
    submarine: 'submarine',
    aircraft: 'aircraft',
    uav: 'uav',
    ground: 'ground_unit',
    unknown: 'unknown',
  }[trackType] || 'unknown';
  return {
    entity_id: track.primary_entity_id,
    contact_id: track.track_id,
    source: 'fused',
    contact_type: trackType,
    lat: Number(track.position?.lat || 0),
    lon: Number(track.position?.lon || 0),
    speed: Number(track.speed || 0),
    heading: Number(track.heading || 0),
    confidence: Number(track.fused_confidence || 0),
    is_hostile: ['hostile', 'red', 'suspicious'].includes(String(track.allegiance || '').toLowerCase()),
    attributes: {
      name: track.track_id,
      subtype: track.track_type || 'unknown',
      unit_class: unitClass,
      allegiance: track.allegiance || 'unknown',
      domain: trackType === 'submarine' ? 'subsurface' : (trackType === 'aircraft' || trackType === 'uav' ? 'air' : 'surface'),
      track_quality: track.source_count >= 3 ? 'high' : (track.source_count === 2 ? 'medium' : 'low'),
      source_system: primarySource,
      fused_track: true,
      fused_confidence: track.fused_confidence,
      source_count: track.source_count,
      sources: track.sources || [],
      rationale: track.rationale || '',
      behavior_flags: [],
      provenance_label: 'Heuristic fusion',
    },
  };
}

