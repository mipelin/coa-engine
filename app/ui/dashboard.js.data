function makeId(prefix) {
  const seed = `${Date.now().toString(36)}${Math.random().toString(36).slice(2, 10)}`;
  return `${prefix}-${seed.slice(0, 8).toUpperCase()}`;
}

function formatParagraphs(text) {
  const chunks = String(text || '')
    .split(/\n{2,}/)
    .map((chunk) => chunk.trim())
    .filter(Boolean);
  return chunks.length ? chunks.map((chunk) => `<p>${esc(chunk)}</p>`).join('') : `<p>${esc(t('common.none', 'None.'))}</p>`;
}

function formatBulletList(items) {
  const values = (items || []).map((item) => String(item || '').trim()).filter(Boolean);
  return values.length ? `<ul>${values.map((item) => `<li>${esc(item)}</li>`).join('')}</ul>` : `<p>${esc(t('common.none', 'None.'))}</p>`;
}

function localizedValue(node, field, fallback = null) {
  if (!node) return fallback;
  const langBlock = node.localized && node.localized[state.uiLanguage];
  if (langBlock && langBlock[field] !== undefined && langBlock[field] !== null) return langBlock[field];
  return node[field] !== undefined && node[field] !== null ? node[field] : fallback;
}

function clearBriefings() {
  state.briefing = null;
  state.briefingLanguage = document.getElementById('briefing-lang')?.value || state.briefingLanguage || 'en';
  const primaryPdf = document.getElementById('btn-pdf');
  const englishPdf = document.getElementById('btn-pdf-en');
  if (primaryPdf) primaryPdf.style.display = 'none';
  if (englishPdf) englishPdf.style.display = 'none';
  if (document.getElementById('bf-body')) renderBriefing();
}

function setSimStatus(message, kind='ok') {
  state.simStatus = message ? {message, kind} : null;
  const box = document.getElementById('sim-status');
  if (!box) return;
  if (!state.simStatus) {
    box.style.display = 'none';
    box.textContent = '';
    box.className = 'sim-status';
    return;
  }
  box.style.display = 'block';
  box.textContent = state.simStatus.message;
  box.className = `sim-status ${state.simStatus.kind}`;
}

function numberOrNull(value) {
  if (value === '' || value === null || value === undefined) return null;
  const num = Number(value);
  return Number.isFinite(num) ? num : null;
}

function setBadge(text, klass) {
  const badge = document.getElementById('badge');
  badge.textContent = text;
  badge.className = `badge ${klass}`;
}

function logLine(message) {
  const elog = document.getElementById('elog');
  const row = document.createElement('div');
  row.className = 'le';
  row.innerHTML = `<span class="lt">${new Date().toISOString().slice(11,19)}Z</span>${esc(message)}`;
  elog.prepend(row);
}

function logAnalysisReason(reason, trigger, tick) {
  if (!reason) return;
  const key = `${tick || 'manual'}|${trigger || 'unknown'}|${reason}`;
  if (state.lastAnalysisLogKey === key) return;
  state.lastAnalysisLogKey = key;
  logLine(`Analysis [${trigger || 'update'}]: ${reason}`);
}

function setWhyChanged(message) {
  state.lastWhyChanged = message || state.lastWhyChanged;
  const node = document.getElementById('why-changed');
  if (node) node.textContent = state.lastWhyChanged;
}

function initMap() {
  state.map = L.map('map').setView([57.5, 19.5], 6);
  setMapStyle('osm-standard');
  focusScenario(state.scenario);
  updateCableRoutes();
  state.map.on('click', async (evt) => {
    state.mapPlacement = evt.latlng;
    state.simDraft.lat = evt.latlng.lat.toFixed(6);
    state.simDraft.lon = evt.latlng.lng.toFixed(6);
    syncSimInputs();
    if (state.mapInteractionMode === 'add') {
      await injectUnit(evt.latlng);
      return;
    }
    if (state.mapInteractionMode === 'move' && state.selectedEntityId) {
      await moveUnitTo(state.selectedEntityId, evt.latlng);
      return;
    }
    renderSimulator();
  });
  state.map.on('moveend', () => {
    if (state.show_ais) fetchVisibleAis();
  });
}

function setMapStyle(styleKey) {
  const selected = MAP_STYLES[styleKey] || MAP_STYLES['osm-standard'];
  if (state.mapLayer) state.map.removeLayer(state.mapLayer);
  state.mapLayer = L.tileLayer(selected.url, selected.options).addTo(state.map);
}

function focusScenario(scenarioId) {
  const bounds = SCENARIO_BOUNDS[scenarioId];
  if (!bounds || !state.map) return;
  state.map.fitBounds(
    [[bounds.lat_min, bounds.lon_min], [bounds.lat_max, bounds.lon_max]],
    {padding: [16, 16]}
  );
}

function updateCableRoutes() {
  if (!state.map) return;
  (state.cableLayers || []).forEach((layer) => state.map.removeLayer(layer));
  state.cableLayers = [];
  if (!state.showCableRoutes) return;

  const CABLE_STATUS_COLORS = {intact: '#2e8b57', severed: '#cc0000', threatened: '#ff6600'};
  const routes = CABLE_ROUTES[state.scenario] || [];
  routes.forEach((route) => {
    const latlngs = (route.points || []).map((point) => [point.lat, point.lon]);
    if (!latlngs.length) return;
    const status = route.status || 'intact';
    const cableColor = CABLE_STATUS_COLORS[status] || CABLE_STATUS_COLORS.intact;
    const dashArray = status === 'threatened' ? '10 8' : null;
    const line = L.polyline(latlngs, {
      color: cableColor,
      weight: 4,
      opacity: 0.8,
      dashArray: dashArray,
    }).addTo(state.map);
    line.bindTooltip(`${route.name} (${status})`, {sticky: true});
    state.cableLayers.push(line);

    const landingSet = new Set(route.landing_points || []);
    latlngs.forEach((latlng, i) => {
      const isLanding = landingSet.has(i);
      if (isLanding || i === 0 || i === latlngs.length - 1) {
        const marker = L.circleMarker(latlng, {
          radius: isLanding ? 6 : 4,
          color: cableColor,
          fillColor: cableColor,
          fillOpacity: 0.7,
          weight: 1,
        }).addTo(state.map);
        marker.bindTooltip(`${route.name} — ${isLanding ? 'Shore Landing' : 'Waypoint'}`, {sticky: true});
        state.cableLayers.push(marker);
      }
    });
  });
}

function activeContacts() {
  return state.contacts.filter((contact) => {
    const allegiance = normalizedAllegiance(contact);
    const hostileKey = allegiance === 'neutral' ? 'neutral' : (allegiance === 'hostile' ? 'hostile' : 'friendly');
    const domainKey = contactDomain(contact);
    const source = contactSource(contact);
    if (source === 'ais' && !state.show_ais) return false;
    if (source === 'combat_system' && !state.show_combat_contacts) return false;
    if (source === 'simulation' && !state.show_sim_entities) return false;
    return state.filters[hostileKey] && state.filters[domainKey];
  });
}

function activeFusedTracks() {
  return (state.fusedTracks || []).filter((track) => {
    const decorated = fusedTrackToRenderable(track);
    const allegiance = normalizedAllegiance(decorated);
    const hostileKey = allegiance === 'neutral' ? 'neutral' : (allegiance === 'hostile' ? 'hostile' : 'friendly');
    const domainKey = contactDomain(decorated);
    return state.filters[hostileKey] && state.filters[domainKey];
  });
}

function mapEntityTypeToContactType(type) {
  const mapping = {
    vessel: 'vessel',
    aircraft: 'uav',
    uav: 'uav',
    submarine: 'submarine',
    ground_unit: 'unknown',
    convoy: 'convoy',
    isr_asset: 'uav',
    neutral_vessel: 'vessel',
    event_marker: 'unknown',
    jamming: 'jamming',
    cable_event: 'cable_event',
    infrastructure: 'infrastructure',
  };
  return mapping[type] || 'unknown';
}

function markerPalette(contact) {
  const allegiance = normalizedAllegiance(contact);
  const source = contactSource(contact);
  if (isEventContact(contact)) return {fill: '#f59e0b', stroke: '#fde68a'};
  if (source === 'ais') {
    if (allegiance === 'hostile') return {fill: '#ef4444', stroke: '#fecaca'};
    if (allegiance === 'neutral') return {fill: '#0ea5e9', stroke: '#cffafe'};
    return {fill: '#14b8a6', stroke: '#ccfbf1'};
  }
  if (source === 'combat_system') {
    if (allegiance === 'hostile') return {fill: '#dc2626', stroke: '#fecaca'};
    if (allegiance === 'neutral') return {fill: '#a855f7', stroke: '#e9d5ff'};
    if (allegiance === 'infrastructure') return {fill: '#14b8a6', stroke: '#ccfbf1'};
    return {fill: '#f59e0b', stroke: '#fde68a'};
  }
  if (allegiance === 'hostile') return {fill: '#dc2626', stroke: '#fecaca'};
  if (allegiance === 'neutral') return {fill: '#94a3b8', stroke: '#f8fafc'};
  if (allegiance === 'infrastructure') return {fill: '#14b8a6', stroke: '#ccfbf1'};
  return {fill: '#2563eb', stroke: '#dbeafe'};
}

function markerSymbolSvg(unitClass, palette, selected = false, source = 'simulation') {
  const outer = selected ? `<circle cx="18" cy="18" r="16" fill="none" stroke="#f8fafc" stroke-width="1.8" stroke-dasharray="2 2"></circle>` : '';
  const common = `fill="${palette.fill}" stroke="${palette.stroke}" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"`;
  const sourceBadge = source === 'combat_system'
    ? `<rect x="11" y="2.5" width="14" height="5.2" rx="1.5" fill="${palette.stroke}" opacity=".95"></rect><text x="18" y="7" text-anchor="middle" font-size="4" font-weight="800" fill="#0f172a">CMS</text>`
    : source === 'ais'
      ? `<rect x="11" y="28.3" width="14" height="5.2" rx="1.5" fill="${palette.stroke}" opacity=".95"></rect><text x="18" y="32.5" text-anchor="middle" font-size="4" font-weight="800" fill="#0f172a">AIS</text>`
      : '';
  const tacticalRing = source === 'combat_system'
    ? `<circle cx="18" cy="18" r="13.5" fill="none" stroke="${palette.stroke}" stroke-width="1.1" stroke-dasharray="1.5 1.5"></circle>`
    : '';
  const symbols = {
    vessel: `<path d="M8 22 L12 11 L24 11 L28 22 L18 28 Z" ${common}></path>`,
    neutral_vessel: `<path d="M8 22 L12 11 L24 11 L28 22 L18 28 Z" ${common}></path><path d="M13 9 L13 5" stroke="${palette.stroke}" stroke-width="1.6"></path>`,
    aircraft: `<path d="M18 5 L21 14 L31 17 L21 20 L18 31 L15 20 L5 17 L15 14 Z" ${common}></path>`,
    uav: `<path d="M18 6 L27 18 L18 30 L9 18 Z" ${common}></path><circle cx="18" cy="18" r="3" fill="${palette.stroke}"></circle>`,
    submarine: `<rect x="7" y="13" width="22" height="10" rx="5" ${common}></rect><path d="M14 13 L14 9 L20 9" stroke="${palette.stroke}" stroke-width="1.6" fill="none"></path><path d="M11 24 Q18 28 25 24" stroke="${palette.stroke}" stroke-width="1.2" fill="none" stroke-dasharray="2 2"></path>`,
    ground_unit: `<rect x="9" y="10" width="18" height="16" rx="2" ${common}></rect><path d="M9 26 L18 31 L27 26" stroke="${palette.stroke}" stroke-width="1.6" fill="none"></path>`,
    convoy: `<rect x="6" y="12" width="8" height="12" rx="1.5" ${common}></rect><rect x="15" y="12" width="8" height="12" rx="1.5" ${common}></rect><rect x="24" y="12" width="6" height="12" rx="1.5" ${common}></rect>`,
    isr_asset: `<circle cx="18" cy="18" r="9" ${common}></circle><path d="M18 4 L18 10 M18 26 L18 32 M4 18 L10 18 M26 18 L32 18" stroke="${palette.stroke}" stroke-width="1.6"></path>`,
    infrastructure: `<path d="M12 28 L18 8 L24 28 Z" ${common}></path><path d="M10 28 L26 28" stroke="${palette.stroke}" stroke-width="1.6"></path>`,
    event_marker: `<path d="M18 6 L29 27 L7 27 Z" ${common}></path><path d="M18 13 L18 20" stroke="${palette.stroke}" stroke-width="1.8"></path><circle cx="18" cy="24" r="1.2" fill="${palette.stroke}"></circle>`,
    jamming: `<circle cx="18" cy="18" r="4" ${common}></circle><path d="M24 12 Q30 18 24 24 M12 12 Q6 18 12 24" stroke="${palette.stroke}" stroke-width="1.8" fill="none"></path>`,
    cable_event: `<path d="M8 14 C12 8, 24 8, 28 14" stroke="${palette.stroke}" stroke-width="1.8" fill="none"></path><path d="M10 22 C14 16, 22 16, 26 22" stroke="${palette.stroke}" stroke-width="1.8" fill="none"></path><path d="M14 12 L22 24 M22 12 L14 24" stroke="${palette.fill}" stroke-width="2.2"></path>`,
    unknown: `<path d="M18 5 L29 12 L29 24 L18 31 L7 24 L7 12 Z" ${common}></path><text x="18" y="22" text-anchor="middle" font-size="14" font-weight="700" fill="${palette.stroke}">?</text>`,
  };
  return `<svg viewBox="0 0 36 36" aria-hidden="true">${outer}${tacticalRing}${symbols[unitClass] || symbols.unknown}${sourceBadge}</svg>`;
}

function markerHtml(contact) {
  const unitClass = normalizeUnitClass(contact);
  const palette = markerPalette(contact);
  const selected = state.selectedEntityId === contact.entity_id;
  const source = contactSource(contact);
  const domainClass = contactDomain(contact);
  const subsurfaceClass = String(contact?.attributes?.domain || '').toLowerCase() === 'subsurface' || contact.contact_type === 'submarine' ? ' subsurface' : '';
  const trackClass = contact.attributes?.track_quality ? ` track-${String(contact.attributes.track_quality).toLowerCase()}` : '';
  return `<div class="unit-icon source-${source} domain-${domainClass}${subsurfaceClass}${trackClass}${selected ? ' selected' : ''}">${markerSymbolSvg(unitClass, palette, selected, source)}</div>`;
}

function markerIcon(contact) {
  return L.divIcon({
    className: 'unit-marker',
    html: markerHtml(contact),
    iconSize: [36, 36],
    iconAnchor: [18, 18],
    popupAnchor: [0, -16],
  });
}

function setSelectedEntity(entityId, source = 'simulation') {
  state.selectedEntityId = entityId || null;
  state.selectedContactSource = source || 'simulation';
  updateMap();
  renderContacts();
  renderSimulator();
  renderContactDetails();
}

function renderMapModeBanner() {
  const node = document.getElementById('map-mode-banner');
  if (!node) return;
  if (state.mapInteractionMode === 'add') {
    node.style.display = 'block';
    node.className = 'map-mode-banner';
    node.textContent = `${t('sim.click_map', 'Click on map to place unit')}: ${state.simDraft.type} · ${state.simDraft.ally}`;
    return;
  }
  if (state.mapInteractionMode === 'move' && state.selectedEntityId) {
    node.style.display = 'block';
    node.className = 'map-mode-banner move';
    node.textContent = `${t('sim.moving_unit', 'Click on map to move unit')}: ${state.selectedEntityId}`;
    return;
  }
  node.style.display = 'none';
  node.textContent = '';
}

function contactDetailValue(value) {
  if (value === null || value === undefined || value === '') return '—';
  if (Array.isArray(value)) return value.length ? value.join(', ') : '—';
  return String(value);
}

function renderContactDetails() {
  const node = document.getElementById('contact-detail-body');
  const status = document.getElementById('contact-detail-status');
  if (!node) return;
  const selectedTrack = findSelectedFusedTrack();
  const selectedTarget = findSelectedTarget();
  const contact = findSelectedContact();
  if (!contact && !selectedTrack) {
    if (status) status.textContent = t('contact.none_selected', 'No contact selected');
    node.innerHTML = `<div class="empty">${esc(t('contact.none_selected', 'No contact selected'))}</div>`;
    return;
  }
  const attrs = contact?.attributes || {};
  const anomaly = contact ? (state.anomalies || []).find((item) => item.entity_id === contact.entity_id) : null;
  const threat = contact ? (state.threats || []).find((item) => item.entity_id === contact.entity_id) : null;
  const behaviorFlags = attrs.behavior_flags || attrs.flags || [];
  const updateTs = contact?.timestamp ? new Date(contact.timestamp).toISOString() : '—';
  const altitudeValue = contact?.attributes?.altitude_ft != null ? `${contact.attributes.altitude_ft} ft` : '—';
  const depthValue = contact?.attributes?.depth_m != null ? `${contact.attributes.depth_m} m` : '—';
  if (status) status.textContent = selectedTrack ? `Heuristic fusion · ${selectedTrack.track_id}` : `${sourceLabel(contact)} · ${contact.entity_id}`;
  node.innerHTML = `
    <div class="cd-title">${esc(selectedTrack ? selectedTrack.track_id : (attrs.name || contact.entity_id))}</div>
    <div class="cd-grid">
      <div><span class="cd-lbl">${esc(t('map.type', 'Type'))}</span><span class="cd-val">${esc(selectedTrack?.track_type || contact.contact_type)}</span></div>
      <div><span class="cd-lbl">${esc(t('map.classification', 'Classification'))}</span><span class="cd-val">${esc(selectedTarget?.type || contact?.attributes?.subtype || normalizeUnitClass(contact || fusedTrackToRenderable(selectedTrack)))}</span></div>
      <div><span class="cd-lbl">${esc(t('map.source', 'Source'))}</span><span class="cd-val">${esc(selectedTrack ? 'Heuristic fusion' : provenanceLabel(contactSource(contact)))}</span></div>
      <div><span class="cd-lbl">${esc(t('map.confidence', 'Confidence'))}</span><span class="cd-val">${esc(fmtPct(selectedTrack?.fused_confidence ?? contact?.confidence))}</span></div>
      <div><span class="cd-lbl">${esc(t('map.track_quality', 'Track Quality'))}</span><span class="cd-val">${esc(contact?.attributes?.track_quality || (selectedTrack ? (selectedTrack.source_count >= 3 ? 'high' : (selectedTrack.source_count === 2 ? 'medium' : 'low')) : '—'))}</span></div>
      <div><span class="cd-lbl">${esc(t('map.last_update', 'Last Update'))}</span><span class="cd-val">${esc(updateTs)}</span></div>
      <div><span class="cd-lbl">${esc(t('map.latitude', 'Latitude'))}</span><span class="cd-val">${esc(fmtCoord(selectedTrack?.position?.lat ?? contact?.lat))}</span></div>
      <div><span class="cd-lbl">${esc(t('map.longitude', 'Longitude'))}</span><span class="cd-val">${esc(fmtCoord(selectedTrack?.position?.lon ?? contact?.lon))}</span></div>
      <div><span class="cd-lbl">${esc(t('map.speed', 'Speed'))}</span><span class="cd-val">${esc(selectedTrack?.speed ?? contact?.speed)} kts</span></div>
      <div><span class="cd-lbl">${esc(t('map.heading', 'Heading'))}</span><span class="cd-val">${esc(selectedTrack?.heading ?? contact?.heading)}°</span></div>
      <div><span class="cd-lbl">${esc(t('map.altitude', 'Altitude'))}</span><span class="cd-val">${esc(altitudeValue)}</span></div>
      <div><span class="cd-lbl">${esc(t('map.depth', 'Depth'))}</span><span class="cd-val">${esc(depthValue)}</span></div>
      <div><span class="cd-lbl">${esc(t('map.anomaly_score', 'Anomaly'))}</span><span class="cd-val">${esc(selectedTrack ? String(Math.round((selectedTrack.anomaly_support || 0) * 100)) : (anomaly ? `${anomaly.anomaly_score}` : '—'))}</span></div>
      <div><span class="cd-lbl">${esc(t('map.threat_score', 'Threat'))}</span><span class="cd-val">${esc(selectedTarget ? selectedTarget.threat_score : (threat ? fmtPct(threat.threat_probability) : '—'))}</span></div>
    </div>
    ${selectedTarget ? `
    <div class="cd-section">
      <div class="cd-lbl">Targeting advisory</div>
      <div class="cd-list">Priority ${esc(selectedTarget.priority_level)} · action ${esc(selectedTarget.recommended_action)} · ROE ${esc(selectedTarget.roe_status)}</div>
      <div class="cd-list">${esc(selectedTarget.rationale || 'No rationale available.')}</div>
    </div>` : ''}
    ${selectedTrack ? `
    <div class="cd-section">
      <div class="cd-lbl">Fusion</div>
      <div class="cd-list">confidence=${esc(fmtPct(selectedTrack.fused_confidence))} · source_count=${esc(String(selectedTrack.source_count || 0))}</div>
      <div class="cd-list">${esc((selectedTrack.sources || []).map((src) => provenanceLabel(src)).join(', ') || '—')}</div>
    </div>` : ''}
    <div class="cd-section">
      <div class="cd-lbl">${esc(t('map.flags', 'Flags'))}</div>
      <div class="cd-list">${esc(contactDetailValue(behaviorFlags))}</div>
    </div>
    <div class="cd-section">
      <div class="cd-lbl">ID</div>
      <div class="cd-list">${esc(selectedTrack ? selectedTrack.track_id : contact.entity_id)}</div>
    </div>
  `;
}

function popupHtml(contact) {
  const attrs = contact.attributes || {};
  const lines = [
    `<b>${esc(attrs.name || contact.entity_id)}</b>`,
    `${esc(t('map.type', 'Type'))}: ${esc(contact.contact_type)}`,
    `${esc(t('map.classification', 'Classification'))}: ${esc(normalizeUnitClass(contact))}`,
    `${esc(t('map.source', 'Source'))}: ${esc(provenanceLabel(contact.source || contactSource(contact)))}`,
    `${esc(t('map.confidence', 'Confidence'))}: ${esc(fmtPct(contact.confidence))}`,
    `${esc(t('map.latitude', 'Latitude'))}: ${esc(fmtCoord(contact.lat))}`,
    `${esc(t('map.longitude', 'Longitude'))}: ${esc(fmtCoord(contact.lon))}`,
    `${esc(t('map.speed', 'Speed'))}: ${esc(contact.speed)} kts`,
    `${esc(t('map.heading', 'Heading'))}: ${esc(contact.heading)}`,
    `${esc(t('map.last_update', 'Last Update'))}: ${esc(contact.timestamp ? new Date(contact.timestamp).toISOString() : '—')}`,
  ];
  if (attrs.fused_track) {
    lines.push(`Fused confidence: ${esc(fmtPct(attrs.fused_confidence))}`);
    lines.push(`Source count: ${esc(String(attrs.source_count || 0))}`);
    lines.push(`Sources: ${esc((attrs.sources || []).map((src) => provenanceLabel(src)).join(', '))}`);
  }
  if (contact.attributes?.altitude_ft != null) lines.push(`${esc(t('map.altitude', 'Altitude'))}: ${esc(contact.attributes.altitude_ft)} ft`);
  if (contact.attributes?.depth_m != null) lines.push(`${esc(t('map.depth', 'Depth'))}: ${esc(contact.attributes.depth_m)} m`);
  if (contact.attributes?.track_quality) lines.push(`${esc(t('map.track_quality', 'Track Quality'))}: ${esc(contact.attributes.track_quality)}`);
  if (attrs.ais_off) lines.push(`${esc(t('map.ais_off', 'AIS'))}: ${esc(t('map.ais_off_value', 'OFF'))}`);
  if (attrs.task === 'approach_point') lines.push(`${esc(t('map.task_approach', 'Task'))}: ${esc(t('map.approaching', 'Approaching'))} ${esc(fmtLatLon(attrs.target_lat, attrs.target_lon))}`);
  if (attrs.behavior_mode) lines.push(`${esc(t('map.behavior', 'Behavior'))}: ${esc(attrs.behavior_mode)}`);
  if (attrs.intent) lines.push(`${esc(t('map.intent', 'Intent'))}: ${esc(attrs.intent)}`);
  if (attrs.target_infra) lines.push(`${esc(t('map.target_infra', 'Target'))}: ${esc(attrs.target_infra)}`);
  if (attrs.reacting_to && attrs.reacting_to.length) lines.push(`${esc(t('map.reacting_to', 'Reacting to'))}: ${esc(attrs.reacting_to.join(', '))}`);
  return lines.join('<br>');
}

function aisPopupHtml(contact) {
  const flags = (contact.suspicious_flags || []).join(', ');
  const lines = [
    `<b>${esc(contact.name || contact.entity_id)}</b>`,
    `${esc(t('map.mmsi', 'MMSI'))}: ${esc(contact.mmsi || '')}`,
    `${esc(t('map.source', 'Source'))}: AIS`,
    `${esc(t('map.confidence', 'Confidence'))}: ${esc(fmtPct(contact.suspicion_score))}`,
    `${esc(t('map.latitude', 'Latitude'))}: ${esc(fmtCoord(contact.lat))}`,
    `${esc(t('map.longitude', 'Longitude'))}: ${esc(fmtCoord(contact.lon))}`,
    `${esc(t('map.speed', 'Speed'))}: ${esc(contact.speed)} kts`,
    `${esc(t('map.heading', 'Heading'))}: ${esc(contact.heading)}`,
    `${esc(t('map.suspicion', 'Suspicion'))}: ${esc(fmtPct(contact.suspicion_score))}`,
  ];
  if (contact.destination) lines.push(`${esc(t('map.destination', 'Destination'))}: ${esc(contact.destination)}`);
  if (contact.nearest_infrastructure) lines.push(`${esc(t('map.nearest_infra', 'Nearest infra'))}: ${esc(contact.nearest_infrastructure)} (${esc(contact.nearest_infrastructure_km)} km)`);
  if (flags) lines.push(`${esc(t('map.flags', 'Flags'))}: ${esc(flags)}`);
  if (contact.considered_in_analysis) lines.push(`${esc(t('map.considered_in_analysis', 'Considered in analysis'))}: ${esc(t('map.considered_yes', 'yes'))}`);
  return lines.join('<br>');
}

function updateMap() {
  const visibleTrackIds = new Set();
  if (state.showFusedTracks) {
    activeFusedTracks().forEach((track) => {
      const trackId = track.track_id;
      visibleTrackIds.add(trackId);
      const rendered = fusedTrackToRenderable(track);
      rendered.attributes.name = track.track_id;
      let marker = state.fusedMarkers.get(trackId);
      if (!marker) {
        marker = L.marker([rendered.lat, rendered.lon], {icon: markerIcon(rendered)}).addTo(state.map);
        state.fusedMarkers.set(trackId, marker);
      } else {
        marker.setLatLng([rendered.lat, rendered.lon]);
        marker.setIcon(markerIcon(rendered));
      }
      marker.bindPopup(popupHtml(rendered));
      marker.off('click').on('click', () => setSelectedEntity(track.primary_entity_id, 'fused'));
    });
  }
  for (const [trackId, marker] of state.fusedMarkers.entries()) {
    if (!visibleTrackIds.has(trackId)) {
      state.map.removeLayer(marker);
      state.fusedMarkers.delete(trackId);
    }
  }

  const visibleIds = new Set();
  if (state.showRawContacts) {
    activeContacts().forEach((contact) => {
      visibleIds.add(contact.entity_id);
      let marker = state.markers.get(contact.entity_id);
      if (!marker) {
        marker = L.marker([contact.lat, contact.lon], {icon: markerIcon(contact)}).addTo(state.map);
        state.markers.set(contact.entity_id, marker);
      } else {
        marker.setLatLng([contact.lat, contact.lon]);
        marker.setIcon(markerIcon(contact));
      }
      marker.bindPopup(popupHtml(contact));
      marker.off('click').on('click', () => setSelectedEntity(contact.entity_id, contactSource(contact)));
    });
  }
  for (const [entityId, marker] of state.markers.entries()) {
    if (!visibleIds.has(entityId)) {
      state.map.removeLayer(marker);
      state.markers.delete(entityId);
    }
  }

  const visibleAisIds = new Set();
  if (state.show_ais) {
    (state.aisContacts || []).forEach((contact) => {
      visibleAisIds.add(contact.entity_id);
      const suspicious = Number(contact.suspicion_score || 0) >= 0.6;
      const decoratedContact = {
        ...contact,
        contact_type: 'vessel',
        entity_id: contact.entity_id,
        is_hostile: suspicious,
        attributes: {
          ...(contact.attributes || {}),
          allegiance: suspicious ? 'hostile' : 'neutral',
          unit_class: suspicious ? 'event_marker' : 'neutral_vessel',
        },
      };
      let marker = state.aisMarkers.get(contact.entity_id);
      if (!marker) {
        marker = L.marker([contact.lat, contact.lon], {icon: markerIcon(decoratedContact)}).addTo(state.map);
        state.aisMarkers.set(contact.entity_id, marker);
      } else {
        marker.setLatLng([contact.lat, contact.lon]);
        marker.setIcon(markerIcon(decoratedContact));
      }
      marker.bindPopup(aisPopupHtml(contact));
      marker.off('click').on('click', () => setSelectedEntity(contact.entity_id, 'ais'));
    });
  }
  for (const [entityId, marker] of state.aisMarkers.entries()) {
    if (!visibleAisIds.has(entityId)) {
      state.map.removeLayer(marker);
      state.aisMarkers.delete(entityId);
    }
  }
}

function upsertContacts(incoming) {
  const merged = new Map((state.contacts || []).map((contact) => [contact.entity_id, contact]));
  (incoming || []).forEach((contact) => merged.set(contact.entity_id, contact));
  state.contacts = [...merged.values()];
}

function renderContacts() {
  const contacts = activeContacts();
  const fusedTracks = activeFusedTracks();
  const tabCount = document.getElementById('tab-ct');
  const statContacts = document.getElementById('s-ct');
  const statTracks = document.getElementById('s-tk');
  const statCoas = document.getElementById('s-co');
  const statProcessed = document.getElementById('s-pr');
  if (tabCount) tabCount.textContent = fusedTracks.length || contacts.length;
  if (statContacts) statContacts.textContent = contacts.length;
  if (statTracks) statTracks.textContent = fusedTracks.length || Object.keys(state.tracks || {}).length;
  if (statCoas) statCoas.textContent = state.coas.length;
  const processed = state.lastState?.contacts_processed ?? 0;
  if (statProcessed) statProcessed.textContent = processed;
  renderFusedTrackList();
  renderTargetPanel();
  const list = document.getElementById('ct-list');
  if (!list) return;
  if (!contacts.length) {
    list.innerHTML = `<div class="empty">${esc(t('contacts.empty', 'No contacts'))}</div>`;
    renderContactDetails();
    return;
  }
  list.innerHTML = contacts.map((contact) => {
    const attrs = contact.attributes || {};
    const source = contactSource(contact);
    const selected = state.selectedEntityId === contact.entity_id && state.selectedContactSource === source;
    const flags = [];
    if (attrs.ais_off) flags.push('AIS OFF');
    if (attrs.suspicious_maneuver) flags.push(t('contact.flag_maneuver', 'Maneuver'));
    if (attrs.task === 'approach_point') flags.push(t('contact.flag_approach', 'Approach'));
    if (attrs.behavior_mode) flags.push(attrs.behavior_mode.replace(/_/g, ' '));
    return `
      <div class="ct-item ${selected ? 'contact-selected' : ''}" data-entity="${esc(contact.entity_id)}" data-source="${esc(source)}">
        <div class="ct-name">${esc(attrs.name || contact.entity_id)}</div>
        <div class="ct-type">${esc(contact.contact_type)} · ${esc(source)}</div>
        <div class="ct-spd">${esc(contact.speed)} kts<br>${esc(fmtLatLon(contact.lat, contact.lon))}</div>
        <div class="ct-warn">${esc(flags.join(' '))}</div>
        <div class="ct-actions">
          <button data-action="select-contact" data-entity="${esc(contact.entity_id)}" data-source="${esc(source)}">Select</button>
          <button data-action="move-contact" data-entity="${esc(contact.entity_id)}">${esc(t('sim.move_unit', 'Move'))}</button>
        </div>
      </div>
    `;
  }).join('');
  renderContactDetails();
}

function renderFusedTrackList() {
  const node = document.getElementById('fused-track-list');
  if (!node) return;
  const tracks = activeFusedTracks();
  if (!tracks.length) {
    node.innerHTML = '<div class="empty">No fused tracks yet.</div>';
    return;
  }
  node.innerHTML = `<div class="cop-list">${tracks.map((track) => {
    const target = (state.targets || []).find((item) => item.entity_id === track.primary_entity_id);
    const selected = state.selectedContactSource === 'fused' && state.selectedEntityId === track.primary_entity_id;
    return `
      <div class="cop-item ${selected ? 'contact-selected' : ''}" data-track="${esc(track.track_id)}">
        <div class="cop-item-title">
          <span>${esc(track.track_id)}</span>
          <span class="cop-chip ${(target?.priority_level || 'low').toLowerCase()}">${esc(target?.priority_level || 'TRACK')}</span>
        </div>
        <div class="cop-item-sub">${esc(track.track_type)} · ${esc(track.allegiance)} · ${esc(fmtLatLon(track.position?.lat, track.position?.lon))}</div>
        <div class="cop-chips">
          <span class="cop-chip">confidence ${esc(fmtPct(track.fused_confidence))}</span>
          <span class="cop-chip">sources ${esc(String(track.source_count || 0))}</span>
          <span class="cop-chip">${esc((track.sources || []).map((src) => provenanceLabel(src)).join(' / '))}</span>
        </div>
        <div class="cop-item-sub">${esc(track.rationale || 'No fusion rationale available.')}</div>
        <div class="ct-actions" style="margin-top:6px">
          <button data-action="select-fused-track" data-entity="${esc(track.primary_entity_id)}">Inspect</button>
        </div>
      </div>
    `;
  }).join('')}</div>`;
}

function renderTargetPanel() {
  const node = document.getElementById('target-panel');
  if (!node) return;
  const target = findSelectedTarget() || (state.topTargets || [])[0];
  if (!target) {
    node.innerHTML = '<div class="empty">No target advisory available yet.</div>';
    return;
  }
  node.innerHTML = `
    <div class="cop-item">
      <div class="cop-item-title">
        <span>${esc(target.entity_id)}</span>
        <span class="cop-chip ${(target.priority_level || 'low').toLowerCase()}">${esc(target.priority_level)}</span>
      </div>
      <div class="metric-grid" style="margin-top:8px">
        <div class="metric-card"><div class="lbl">Classification</div><div class="val">${esc(target.type)}</div></div>
        <div class="metric-card"><div class="lbl">Threat</div><div class="val">${esc(String(target.threat_score))}</div></div>
        <div class="metric-card"><div class="lbl">Action</div><div class="val">${esc(target.recommended_action)}</div></div>
        <div class="metric-card"><div class="lbl">ROE</div><div class="val">${esc(target.roe_status)}</div></div>
      </div>
      <div class="cop-chips">
        ${(target.sources || []).map((src) => `<span class="cop-chip">${esc(provenanceLabel(src))}</span>`).join('')}
      </div>
      <div class="cop-item-sub">${esc(target.rationale || 'No rationale available.')}</div>
    </div>
  `;
}



function roeRecommendationWarning(coa){
  if(!coa||!coa.roe_status||coa.roe_status==='allowed')return'';
  const icon=coa.roe_status==='rejected'?'&#x1F6D1;':'&#x26A0;';
  const label=coa.roe_status==='rejected'?'Rejected by ROE':'Authorization Required';
  return'<div class="roe-auth-warning"><span class="roe-auth-icon">'+icon+'</span> <b>'+esc(label)+':</b> '+esc(coa.roe_reason||'This COA has ROE restrictions')+' <span class="roe-auth-badge">'+esc(coa.roe_status)+'</span></div>';
}

function roeStatusClass(coa){const s=(coa.roe_status||"allowed").toLowerCase().replace(/ /g,"_");return"roe-badge "+s}
function roeStatusIcon(coa){const s=(coa.roe_status||"allowed").toLowerCase();const m={allowed:"&#x2713;",restricted:"&#x26A0;",requires_authorization:"&#x26D4;",rejected:"&#x1F6D1;"};return m[s]||""}
function roeStatusLabel(coa){const s=(coa.roe_status||"allowed").toLowerCase();const labels={allowed:"&#x2713; Allowed",restricted:"&#x26A0; Restricted",requires_authorization:"&#x26D4; Auth Required",rejected:"&#x1F6D1; Rejected"};return labels[s]||(coa.roe_status||"Allowed")}
function roeCardClass(coa){return"roe-"+(coa.roe_status||"allowed").toLowerCase().replace(/ /g,"_")}
function roeReasonStrip(coa){
  if(!coa)return'';
  const s=(coa.roe_status||"allowed").toLowerCase().replace(/ /g,"_");
  if(s==='allowed'&&(!coa.roe_reason||!coa.roe_reason.trim()))return'<div class="roe-reason-strip allowed"><span class="roe-strip-icon">&#x2713;</span><span>ROE cleared — no restrictions triggered</span></div>';
  const icons={allowed:"&#x2713;",restricted:"&#x26A0;",requires_authorization:"&#x26D4;",rejected:"&#x1F6D1;"};
  const reason=coa.roe_reason||"No reason provided";
  return'<div class="roe-reason-strip '+esc(s)+'"><span class="roe-strip-icon">'+(icons[s]||"")+'</span><span>'+esc(reason)+'</span></div>';
}
function roeBannerHtml(coas){
  if(!coas||!coas.length)return'';
  const auth=coas.filter(i=>{const s=(i.coa||{}).roe_status||"allowed";return s==="requires_authorization"||s==="rejected"});
  if(!auth.length)return'';
  const rejected=auth.filter(i=>(i.coa||{}).roe_status==="rejected").length;
  const needsAuth=auth.filter(i=>(i.coa||{}).roe_status==="requires_authorization").length;
  let msg='';
  if(needsAuth)msg+=needsAuth+' COA'+(needsAuth>1?'s':'')+' require'+(needsAuth===1?'s':'')+' authorization before execution. ';
  if(rejected)msg+=rejected+' COA'+(rejected>1?'s':'')+(rejected===1?' is':' are')+' blocked by ROE constraints. ';
  return'<div class="roe-banner"><span class="roe-banner-icon">&#x26D4;</span><div><b>ROE Alert:</b> '+esc(msg.trim())+'</div><span class="roe-banner-status">'+esc(String(auth.length))+' flagged</span></div>';
}

function coaColor(score) {
  if (score >= 80) return '#22c55e';
  if (score >= 60) return '#eab308';
  return '#f97316';
}

function renderDecisionPanel() {
  const node = document.getElementById('decision-panel');
  if (!node) return;
  const panel = state.decisionPanel || {};
  const rec = panel.current_recommendation;
  const variants = panel.optimized_variants || [];
  const forecast = state.forecastSummary || {};
  if (!rec && !variants.length) {
    node.innerHTML = '<div class="empty">Awaiting decision panel</div>';
    return;
  }
  node.innerHTML = `
    <div class="cop-card">
      <div class="cop-card-kicker">Deterministic recommendation</div>
      <h3>${esc(rec?.title || 'Recommendation pending')}</h3>
      <div class="metric-grid">
        <div class="metric-card"><div class="lbl">Score</div><div class="val">${esc(rec ? rec.score : '--')}</div></div>
        <div class="metric-card"><div class="lbl">Success</div><div class="val">${esc(rec ? fmtPct(rec.success_probability) : '--')}</div></div>
        <div class="metric-card"><div class="lbl">ROE</div><div class="val">${esc(rec?.roe_status || '--')}</div></div>
        <div class="metric-card"><div class="lbl">Forecast</div><div class="val">${esc(forecast.available ? forecast.trend_direction : 'pending')}</div></div>
      </div>
      <div class="delta-list">
        <div class="cop-item"><div class="cop-card-kicker">Why this wins</div><p>${esc(rec?.rationale || 'No current recommendation rationale available.')}</p></div>
        ${variants.length ? variants.map((variant) => `
          <div class="cop-item">
            <div class="cop-item-title">
              <span>${esc(variant.title)}</span>
              <span class="cop-chip ${esc((variant.roe_status || 'allowed').toLowerCase())}">${esc(variant.roe_status || 'allowed')}</span>
            </div>
            <div class="metric-grid" style="margin-top:8px">
              <div class="metric-card"><div class="lbl">Robustness</div><div class="val">${esc(String(variant.robustness))}</div></div>
              <div class="metric-card"><div class="lbl">Success</div><div class="val">${esc(fmtPct(variant.success_probability))}</div></div>
              <div class="metric-card"><div class="lbl">Escalation</div><div class="val">${esc(fmtPct(variant.escalation_probability))}</div></div>
              <div class="metric-card"><div class="lbl">Score</div><div class="val">${esc(String(variant.total_score))}</div></div>
            </div>
            <div class="cop-item-sub">${esc(variant.tradeoff_explanation || 'No tradeoff explanation provided.')}</div>
            <div class="cop-chips">
              ${variant.parameters ? Object.entries(variant.parameters).filter(([key]) => !['variant_id', 'base_template_id', 'variant_label'].includes(key)).map(([key, value]) => `<span class="cop-chip">${esc(key)}=${esc(String(value))}</span>`).join('') : ''}
            </div>
          </div>
        `).join('') : '<div class="cop-item"><div class="cop-item-sub">No optimized variants available yet.</div></div>'}
      </div>
    </div>
  `;
}

function renderOperationalEffectsPanel() {
  const node = document.getElementById('effects-panel');
