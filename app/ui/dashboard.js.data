        <div class="metric-card"><div class="lbl">Detection</div><div class="val">${esc(String(effects.detection_modifier ?? '--'))}</div></div>
        <div class="metric-card"><div class="lbl">Success</div><div class="val">${esc(String(effects.coa_success_modifier ?? '--'))}</div></div>
        <div class="metric-card"><div class="lbl">Time</div><div class="val">${esc(String(effects.time_modifier ?? '--'))}</div></div>
        <div class="metric-card"><div class="lbl">Risk</div><div class="val">${esc(String(effects.risk_modifier ?? '--'))}</div></div>
      </div>
      <div class="cop-chips">${active.map((item) => `<span class="cop-chip">${esc(item)}</span>`).join('')}</div>
    </div>
  `;
}

function renderReplayPanel() {
  const node = document.getElementById('replay-panel');
  if (!node) return;
